---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../lib/i18n';
import { localizedPath } from '../lib/i18n';
import BaseLayout from '../layouts/BaseLayout.astro';
import Gallery from './Gallery.astro';
import ServiceCard from './ServiceCard.astro';
import WhatsAppButton from './WhatsAppButton.astro';

type HomeData = Extract<CollectionEntry<'pages'>['data'], { pageType: 'home' }>;

interface Props {
	locale: Locale;
	page: HomeData;
	settings: CollectionEntry<'settings'>['data'];
}

const { locale, page, settings } = Astro.props;
---

<BaseLayout
	locale={locale}
	title={page.seoTitle}
	description={page.seoDescription}
	settings={settings}
>
	<section class="home-hero">
		<div class="container hero-grid">
			<div class="hero-copy">
				<p class="eyebrow">Máncora · Perú</p>
				<h1>{page.heroTitle}</h1>
				<p>{page.heroSubtitle}</p>
				<WhatsAppButton
					number={settings.whatsappNumber}
					message={settings.whatsappDefaultMessage}
					label={locale === 'es' ? 'Escríbeme por WhatsApp' : 'Message me on WhatsApp'}
				/>
			</div>
			<Gallery
				images={page.gallery}
				label={locale === 'es' ? 'Fotos de las clases' : 'Lesson photos'}
			/>
		</div>
	</section>

	<section class="section">
		<div class="container about-grid">
			<p class="eyebrow">{locale === 'es' ? 'Tu instructor local' : 'Your local instructor'}</p>
			<div>
				<h2>{page.aboutTitle}</h2>
				<p class="about-copy">{page.aboutBody}</p>
			</div>
		</div>
	</section>

	<section class="section services">
		<div class="container service-grid">
			<ServiceCard
				{...page.surfTeaser}
				href={localizedPath(locale, 'surf')}
				variant="surf"
			/>
			<ServiceCard
				{...page.kitesurfTeaser}
				href={localizedPath(locale, 'kitesurf')}
				variant="kitesurf"
			/>
		</div>
	</section>
</BaseLayout>

<style>
	.home-hero {
		overflow: hidden;
		padding-block: clamp(3.5rem, 8vw, 6.5rem);
		background:
			radial-gradient(circle at 12% 8%, rgb(255 255 255 / 70%), transparent 20rem),
			linear-gradient(140deg, var(--ocean-100), var(--sand-200));
	}

	.hero-grid,
	.about-grid,
	.service-grid {
		display: grid;
		gap: 2rem;
	}

	.hero-copy {
		align-self: center;
	}

	.hero-copy > p:not(.eyebrow) {
		max-width: 38rem;
		font-size: clamp(1.15rem, 2.5vw, 1.4rem);
	}

	.about-grid {
		max-width: 60rem;
	}

	.about-copy {
		font-size: clamp(1.15rem, 2.4vw, 1.4rem);
	}

	.services {
		padding-top: 0;
	}

	@media (min-width: 52rem) {
		.hero-grid {
			grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
			align-items: center;
			gap: 3rem;
		}

		.about-grid {
			grid-template-columns: 0.45fr 1fr;
			align-items: start;
		}

		.service-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
</style>
