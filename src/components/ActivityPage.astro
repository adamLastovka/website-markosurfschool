---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../lib/i18n';
import BaseLayout from '../layouts/BaseLayout.astro';
import Gallery from './Gallery.astro';
import PricingTable from './PricingTable.astro';
import WhatsAppButton from './WhatsAppButton.astro';

type ActivityData = Extract<
	CollectionEntry<'pages'>['data'],
	{ pageType: 'surf' | 'kitesurf' }
>;

interface Props {
	locale: Locale;
	page: ActivityData;
	settings: CollectionEntry<'settings'>['data'];
}

const { locale, page, settings } = Astro.props;
const labels =
	locale === 'es'
		? { includes: 'Qué incluye', prices: 'Clases y precios', photos: 'Fotos', availability: 'Disponibilidad' }
		: { includes: 'What is included', prices: 'Lessons and pricing', photos: 'Photos', availability: 'Availability' };
---

<BaseLayout
	locale={locale}
	currentPath={page.pageType}
	title={page.seoTitle}
	description={page.seoDescription}
	settings={settings}
>
	<header class="page-hero">
		<div class="container">
			<p class="eyebrow">Máncora · Perú</p>
			<h1>{page.title}</h1>
			<p>{page.intro}</p>
		</div>
	</header>

	<section class="section">
		<div class="container details-grid">
			<div>
				<div class="prose">
					<p class="lead">{page.body}</p>
				</div>
				<h2>{labels.photos}</h2>
				<Gallery images={page.images} label={labels.photos} />
			</div>
			<aside class="panel">
				<h2>{labels.includes}</h2>
				<ul class="feature-list">
					{page.includes.map((item) => <li>{item}</li>)}
				</ul>
				{page.availabilityNote && (
					<>
						<h3>{labels.availability}</h3>
						<p class="muted">{page.availabilityNote}</p>
					</>
				)}
			</aside>
		</div>
	</section>

	<section class="section pricing-section">
		<div class="container pricing-wrap">
			<PricingTable items={page.pricing} title={labels.prices} />
			<div class="contact-card">
				<h2>{page.contactCta.text}</h2>
				<WhatsAppButton
					number={settings.whatsappNumber}
					message={settings.whatsappDefaultMessage}
					label={page.contactCta.buttonLabel}
				/>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.lead {
		margin-bottom: 3rem;
		font-size: 1.2rem;
	}

	.details-grid h2:not(:first-child) {
		margin-top: 3rem;
	}

	.pricing-section {
		background: var(--ocean-100);
	}

	.pricing-wrap {
		display: grid;
		gap: 2rem;
	}

	.contact-card {
		padding: clamp(1.5rem, 4vw, 2.5rem);
		border-radius: var(--radius);
		background: var(--ocean-950);
		color: var(--white);
	}

	.contact-card h2 {
		color: var(--white);
		font-size: clamp(1.7rem, 4vw, 2.5rem);
	}

	@media (min-width: 52rem) {
		.pricing-wrap {
			grid-template-columns: 1fr 0.75fr;
			align-items: start;
		}
	}
</style>
