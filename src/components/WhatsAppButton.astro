---
interface Props {
	number: string;
	message: string;
	label: string;
	class?: string;
}

const { number, message, label, class: className } = Astro.props;
const cleanNumber = number.replace(/\D/g, '');
const href = `https://wa.me/${cleanNumber}?text=${encodeURIComponent(message)}`;
---

<a class:list={['button', 'whatsapp-button', className]} href={href} target="_blank" rel="noopener">
	<svg aria-hidden="true" viewBox="0 0 24 24">
		<path d="M12 2a9.8 9.8 0 0 0-8.4 14.9L2.3 22l5.2-1.4A10 10 0 1 0 12 2Zm0 18.2a8.1 8.1 0 0 1-4.1-1.1l-.3-.2-3.1.8.8-3-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.6 6.6 0 0 1-3.3-2.9c-.2-.3 0-.4.1-.6l.4-.5.2-.5v-.5c-.1-.1-.6-1.5-.8-2-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.3-.3.3-1 1-1 2.4s1 2.8 1.2 3c.1.2 2.1 3.2 5 4.4.7.3 1.2.5 1.7.6.7.2 1.3.2 1.8.1.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.6-.3Z" />
	</svg>
	{label}
</a>

<style>
	.whatsapp-button {
		gap: 0.55rem;
		background: #158a55;
	}

	svg {
		width: 1.35rem;
		fill: currentColor;
	}
</style>
