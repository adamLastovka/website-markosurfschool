---
import ActivityPage from '../../components/ActivityPage.astro';
import { getPage, getSiteSettings } from '../../lib/content';

const [page, settings] = await Promise.all([getPage('es', 'kitesurf'), getSiteSettings('es')]);
if (page.pageType !== 'kitesurf') throw new Error('Invalid Spanish kitesurf content');
---

<ActivityPage locale="es" {page} {settings} />
